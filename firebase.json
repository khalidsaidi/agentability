{
  "hosting": {
    "public": "dist-static",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.DS_Store",
      "**/.git/**"
    ],
    "redirects": [
      {
        "source": "/guides/ai-readiness-audit-checklist.html",
        "destination": "/guides/ai-readiness-audit-checklist/",
        "type": 301
      },
      {
        "source": "/guides/llms-txt-openapi-for-ai-agents.html",
        "destination": "/guides/llms-txt-openapi-for-ai-agents/",
        "type": 301
      },
      {
        "source": "/guides/technical-seo-for-ai-discovery.html",
        "destination": "/guides/technical-seo-for-ai-discovery/",
        "type": 301
      },
      {
        "source": "/guides/index.html",
        "destination": "/guides/",
        "type": 301
      },
      {
        "source": "/seo/framework/**",
        "destination": "/guides/llms-txt-openapi-for-ai-agents/",
        "type": 301
      },
      {
        "source": "/seo/**",
        "destination": "/guides/ai-readiness-audit-checklist/",
        "type": 301
      },
      {
        "source": "/seo",
        "destination": "/guides/ai-readiness-audit-checklist/",
        "type": 301
      },
      {
        "source": "/agents.txt",
        "destination": "/llms.txt",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/badge/**",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/svg+xml; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/data/**",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/.well-known/mcp/server-card.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/openapi.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/.well-known/mcp-registry-auth",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/.well-known/openai-apps-challenge",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/check",
        "function": {
          "functionId": "check",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "src",
        "test",
        ".git",
        "*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
